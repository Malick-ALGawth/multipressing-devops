# Copiez ce fichier en .env puis remplissez chaque valeur (ou laissez Ansible le générer depuis le vault).
# Générez les secrets avec : openssl rand -hex 32

# Nom de domaine qui pointe vers le serveur (enregistrement DNS de type A)
DOMAIN=gestion.exemple.com

# Image publiée par la CI ; APP_TAG est mis à jour par deploy.sh à chaque déploiement
APP_IMAGE=ghcr.io/votre-compte/multipressing
APP_TAG=latest
LOG_LEVEL=info
# Adresse publique du site (liens de paiement, retour après paiement). Par défaut : https://DOMAIN
PUBLIC_URL=

# Base de données
POSTGRES_DB=multipressing
POSTGRES_USER=multipressing
POSTGRES_PASSWORD=remplacez-par-openssl-rand-hex-32

# Secret des sessions de connexion (au moins 32 caractères)
SESSION_SECRET=remplacez-par-openssl-rand-hex-32
# Clé de chiffrement des secrets de double authentification (différente de SESSION_SECRET)
ENCRYPTION_KEY=remplacez-par-openssl-rand-hex-32

# Sauvegardes : notez la phrase de chiffrement en lieu sûr, hors du serveur.
BACKUP_PASSPHRASE=remplacez-par-une-longue-phrase-secrete
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=02

# Copie des sauvegardes hors du serveur (facultatif, stockage compatible S3)
RCLONE_REMOTE=
OFFSITE_PROVIDER=Other
OFFSITE_ENDPOINT=
OFFSITE_REGION=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=

# Supervision (profil « monitoring »)
GRAFANA_ADMIN_PASSWORD=remplacez-moi
