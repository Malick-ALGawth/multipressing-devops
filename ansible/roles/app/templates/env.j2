# {{ ansible_managed }} — environnement {{ app_env }}
DOMAIN={{ app_domain }}
APP_IMAGE={{ app_image }}
APP_TAG={{ app_tag }}
LOG_LEVEL={{ log_level }}
PUBLIC_URL=https://{{ app_domain }}

POSTGRES_DB=multipressing
POSTGRES_USER=multipressing
POSTGRES_PASSWORD={{ vault_postgres_password }}
SESSION_SECRET={{ vault_session_secret }}
ENCRYPTION_KEY={{ vault_encryption_key }}

BACKUP_PASSPHRASE={{ vault_backup_passphrase }}
BACKUP_KEEP_DAYS={{ backup_keep_days }}
BACKUP_HOUR={{ backup_hour }}
RCLONE_REMOTE={{ vault_rclone_remote | default('') }}
OFFSITE_PROVIDER={{ vault_offsite_provider | default('Other') }}
OFFSITE_ENDPOINT={{ vault_offsite_endpoint | default('') }}
OFFSITE_REGION={{ vault_offsite_region | default('') }}
OFFSITE_ACCESS_KEY_ID={{ vault_offsite_access_key_id | default('') }}
OFFSITE_SECRET_ACCESS_KEY={{ vault_offsite_secret_access_key | default('') }}

GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
