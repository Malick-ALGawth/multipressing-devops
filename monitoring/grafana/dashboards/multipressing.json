{
 "uid": "multipressing",
 "title": "Multipressing — production",
 "timezone": "Africa/Dakar",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Version en ligne",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app_info",
     "legendFormat": "{{version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "id": 1
  },
  {
   "type": "stat",
   "title": "Requêtes / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{route!=\"statique\"}[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {},
   "id": 2
  },
  {
   "type": "stat",
   "title": "Erreurs serveur (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])),0.001)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "id": 3
  },
  {
   "type": "stat",
   "title": "Échecs de connexion (1 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(mp_login_failures_total[1h])",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Latence p95 par route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{route!=\"statique\"}[5m])))",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Requêtes par statut",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_request_duration_seconds_count[5m]))",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {},
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Tickets créés par boutique (par heure)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (shop) (increase(mp_tickets_created_total[1h]))",
     "legendFormat": "{{shop}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Encaissements par mode (FCFA, par heure)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method) (increase(mp_payments_fcfa_total[1h]))",
     "legendFormat": "{{method}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "CPU du serveur",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Mémoire disponible",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Disque libre (/)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "id": 11
  }
 ],
 "tags": [
  "multipressing"
 ]
}