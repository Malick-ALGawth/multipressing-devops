{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# Pendant le redémarrage de l'application (déploiement), Caddy garde les requêtes en attente
		# au lieu de renvoyer une erreur : les utilisateurs ne voient pas de coupure.
		lb_try_duration 20s
		lb_try_interval 500ms
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}
